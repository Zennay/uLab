{
  "runner": {
    "type": "docker-compose",
    "compose_file": "examples/stateful-upgrade/compose.yaml"
  },
  "versions": {
    "from": ["v1", "v1.1", "v1.2"],
    "to": "v2"
  },
  "setup": {
    "command": "./examples/stateful-upgrade/scripts/setup.sh"
  },
  "upgrade": {
    "command": "./examples/stateful-upgrade/scripts/upgrade.sh"
  },
  "verify": {
    "command": "./examples/stateful-upgrade/scripts/verify.sh"
  },
  "policy": {
    "require_all_paths": true,
    "auto_concurrency": true,
    "memory_reserve_mb": 2048,
    "memory_per_job_mb": 1024
  }
}
